# CekTipu — local dev config
# Copy this file to `.env.local` and fill in the values from your Firebase
# project (console.firebase.google.com → Project settings → Your apps → Web).
# NEVER commit `.env.local` (it is git-ignored). No secrets live here —
# the Firebase web config is public-by-design; real protection is App Check.

# --- Firebase web config (required) ---------------------------------------
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# --- App Check (pick ONE) --------------------------------------------------
# Local dev: set to `true` to use the App Check debug provider. The SDK will
# print a debug token to the browser console — register it in the Firebase
# console (App Check → Apps → Manage debug tokens). NEVER commit the token.
VITE_APPCHECK_DEBUG_TOKEN=true

# Production: a real reCAPTCHA Enterprise site key from Google Cloud Console.
# Leave empty for local dev.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
